# ==============================================================================
# AuditFlow Field Capture & Master Registry - Backend Configuration
# ==============================================================================

# Supabase PostgreSQL Database Connection URL
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials.
#
# Option A: Supabase Direct Connection (Session Mode, Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Supabase Transaction Pooler (Recommended for high concurrency / Serverless / Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
#
# Option C: Supabase Session Pooler (Port 5432)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Database Connection Pool Settings (Optional fine-tuning)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional Discrete PostgreSQL Parameters (Used if DATABASE_URL is not provided)
# POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_PASSWORD
# POSTGRES_DB=postgres
